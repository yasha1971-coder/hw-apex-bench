{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hw-apex:axis3-evidence:v1",
  "title": "Axis 3 frozen-protocol evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "axis",
    "kind",
    "run_id",
    "status",
    "format",
    "variant",
    "scope",
    "threads",
    "n_assemblies",
    "window_bytes",
    "samples",
    "verified",
    "codec_commit",
    "protocol",
    "runbook",
    "corpus_manifest",
    "requests",
    "raw_logs",
    "metrics",
    "error",
    "hardware",
    "build",
    "silence_gate"
  ],
  "properties": {
    "schema": {
      "const": "axis3-evidence-v1"
    },
    "axis": {
      "const": 3
    },
    "kind": {
      "enum": [
        "synthetic",
        "measured"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAILED"
      ]
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "cpu-in-process",
        "gpu-in-process",
        "cli"
      ]
    },
    "threads": {
      "type": "integer",
      "minimum": 1
    },
    "n_assemblies": {
      "type": "integer",
      "minimum": 1
    },
    "window_bytes": {
      "enum": [
        1024,
        8192,
        65536
      ]
    },
    "samples": {
      "const": 10000
    },
    "verified": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "codec_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "protocol": {
      "$ref": "#/$defs/file"
    },
    "runbook": {
      "$ref": "#/$defs/file"
    },
    "corpus_manifest": {
      "$ref": "#/$defs/file"
    },
    "requests": {
      "$ref": "#/$defs/file"
    },
    "raw_logs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "metrics": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/metrics"
        }
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_id",
        "cpu_model",
        "frequency_policy"
      ],
      "properties": {
        "machine_id": {
          "type": "string",
          "minLength": 1
        },
        "cpu_model": {
          "type": "string",
          "minLength": 1
        },
        "frequency_policy": {
          "type": "string",
          "minLength": 1
        },
        "gpu": {
          "type": "string"
        },
        "driver": {
          "type": "string"
        },
        "cuda": {
          "type": "string"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "flags",
        "binary_sha256",
        "dependencies"
      ],
      "properties": {
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependencies": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "silence_gate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/file"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "verified": {
            "const": 10000
          },
          "metrics": {
            "$ref": "#/$defs/metrics"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "metrics": {
            "type": "null"
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "cpu-in-process"
          }
        }
      },
      "then": {
        "properties": {
          "threads": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "measured"
          }
        }
      },
      "then": {
        "properties": {
          "silence_gate": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "gpu-in-process"
          }
        }
      },
      "then": {
        "properties": {
          "hardware": {
            "required": [
              "gpu",
              "driver",
              "cuda"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stored_bytes",
        "bytes_per_assembly",
        "build_seconds",
        "peak_rss_bytes",
        "p50_us",
        "p95_us",
        "p99_us",
        "windows_per_second",
        "Q_actual_bytes"
      ],
      "properties": {
        "stored_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "bytes_per_assembly": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "build_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "peak_rss_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "p50_us": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p95_us": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p99_us": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "windows_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "Q_actual_bytes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}
